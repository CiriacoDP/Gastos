<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Controle de Gastos</title>
<style>
:root{--bg:#f5f7fb;--card:#fff;--text:#253047;--muted:#8490a5;--primary:#6478d3;--green:#26a879;--red:#df6876;--border:#e9edf4;--shadow:0 5px 20px rgba(36,52,82,.06)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);font-family:Arial,sans-serif;color:var(--text)}
.container{max-width:1100px;margin:auto;padding:28px 20px}
header{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:25px}
h1{font-size:25px;margin:0}
.subtitle{color:var(--muted);font-size:13px;margin-top:6px}
.card{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:20px;box-shadow:var(--shadow)}
.summary{display:grid;grid-template-columns:repeat(3,1fr);gap:15px;margin-bottom:20px}
.summary .label{font-size:13px;color:var(--muted)}
.summary .value{font-size:25px;font-weight:700;margin-top:10px}
.green{color:var(--green)}
.red{color:var(--red)}
.content{display:grid;grid-template-columns:350px 1fr;gap:20px}
h2{font-size:17px;margin:0 0 18px}
label{display:block;font-size:12px;color:var(--muted);margin:13px 0 6px}
input,select{width:100%;padding:12px;border:1px solid var(--border);border-radius:9px;background:#fff;color:var(--text);font-size:14px;outline:none}
input:focus,select:focus{border-color:var(--primary)}
button{border:0;border-radius:9px;padding:11px 15px;background:var(--primary);color:#fff;font-weight:600;cursor:pointer}
button:hover{opacity:.88}
button.secondary{background:#eef0fb;color:var(--primary)}
button.danger{background:#fff0f1;color:var(--red)}
button.small{padding:8px 10px;font-size:12px}
.actions{display:flex;gap:7px;flex-wrap:wrap}
.submit{width:100%;margin-top:18px}
.filters{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:16px}
.filters button{font-size:12px;padding:9px 12px}
.filters button.active{background:var(--primary);color:#fff}
.entry{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:15px 0;border-bottom:1px solid var(--border)}
.entry:last-child{border:0}
.entry-title{font-size:14px;font-weight:600}
.entry-meta{font-size:12px;color:var(--muted);margin-top:5px}
.entry-value{font-size:15px;font-weight:700;text-align:right;white-space:nowrap}
.entry-right{display:flex;align-items:center;gap:12px}
.status{font-size:11px;padding:5px 8px;border-radius:20px;background:#fff1df;color:#bd853b;display:inline-block;margin-top:6px}
.status.paid{background:#e4f7ef;color:#26966e}
.empty{text-align:center;padding:35px 10px;color:var(--muted);font-size:13px}
.top-actions{display:flex;gap:8px;align-items:center}
#message{font-size:12px;margin-top:10px;color:var(--muted)}
@media(max-width:750px){
.container{padding:20px 13px}
header{align-items:flex-start}
h1{font-size:21px}
.summary{gap:8px}
.summary .card{padding:13px}
.summary .value{font-size:18px}
.summary .label{font-size:11px}
.content{grid-template-columns:1fr}
.entry{align-items:flex-start}
.entry-right{flex-direction:column;align-items:flex-end;gap:7px}
.entry-title{max-width:190px}
}
</style>
</head>
<body>
<div class="container">
<header>
<div>
<h1>Meu controle financeiro</h1>
<div class="subtitle">Organize suas entradas, despesas e dívidas.</div>
</div>
<div class="top-actions">
<button class="secondary small" onclick="configure()">⚙ Configurar</button>
</div>
</header>

<section class="summary">
<div class="card">
<div class="label">Total de entradas</div>
<div class="value green" id="income">R$ 0,00</div>
</div>
<div class="card">
<div class="label">Total de despesas</div>
<div class="value red" id="expenses">R$ 0,00</div>
</div>
<div class="card">
<div class="label">Saldo previsto</div>
<div class="value" id="balance">R$ 0,00</div>
</div>
</section>

<div class="content">
<section class="card">
<h2 id="formTitle">Adicionar movimentação</h2>
<form id="entryForm">
<input type="hidden" id="entryId">

<label for="person">Pessoa</label>
<select id="person">
<option value="Diego">Diego</option>
<option value="Thamiris">Thamiris</option>
<option value="Casal">Casal</option>
</select>

<label for="type">Movimentação</label>
<select id="type" onchange="updateType()">
<option value="Gasto">Gasto</option>
<option value="Entrada">Entrada</option>
<option value="Dívida">Dívida</option>
</select>

<div id="expenseTypeGroup">
<label for="expenseType">Tipo de despesa</label>
<select id="expenseType">
<option value="Fixa">Fixa</option>
<option value="Variável">Variável</option>
</select>
</div>

<label for="month">Mês</label>
<input type="month" id="month" required>

<label for="description">Descrição</label>
<input type="text" id="description" placeholder="Ex.: Aluguel, salário..." required>

<label for="amount">Valor (R$)</label>
<input type="number" id="amount" min="0.01" step="0.01" placeholder="0,00" required>

<button type="submit" class="submit" id="saveButton">Adicionar</button>
<button type="button" class="secondary submit" id="cancelEdit" onclick="resetForm()" style="display:none">Cancelar edição</button>
</form>
<div id="message"></div>
</section>

<section class="card">
<h2>Movimentações</h2>
<div class="filters">
<button class="active" data-filter="all" onclick="setFilter('all',this)">Todas</button>
<button class="secondary" data-filter="unpaid" onclick="setFilter('unpaid',this)">Não pagas</button>
<button class="secondary" data-filter="paid" onclick="setFilter('paid',this)">Pagas</button>
<button class="secondary" data-filter="income" onclick="setFilter('income',this)">Entradas</button>
</div>
<div id="entries">
<div class="empty">Carregando movimentações...</div>
</div>
</section>
</div>
</div>

<script>
let API_URL = localStorage.getItem('gastos2026_appweb_url_v1') || '';
let entries = [];
let currentFilter = 'all';

const $ = id => document.getElementById(id);
const money = value => Number(value || 0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});

function message(text){
$('message').textContent = text;
}

function configure(){
const url = prompt('Cole aqui a URL do seu Google Apps Script:',API_URL);
if(url === null) return;
API_URL = url.trim();
localStorage.setItem('gastos2026_appweb_url_v1',API_URL);
loadData();
}

function updateType(){
$('expenseTypeGroup').style.display = $('type').value === 'Entrada' ? 'none' : 'block';
}

function setFilter(filter,button){
currentFilter = filter;
document.querySelectorAll('.filters button').forEach(b=>{
b.classList.remove('active');
b.classList.add('secondary');
});
button.classList.add('active');
button.classList.remove('secondary');
render();
}

async function loadData(){
if(!API_URL){
$('entries').innerHTML = '<div class="empty">Configure a URL do Google Apps Script para começar.</div>';
return;
}
try{
$('entries').innerHTML = '<div class="empty">Carregando...</div>';
const response = await fetch(API_URL + '?action=state');
if(!response.ok) throw new Error('Erro na comunicação com a planilha.');
const data = await response.json();
entries = Array.isArray(data) ? data : (data.entries || data.data || []);
render();
}catch(error){
$('entries').innerHTML = '<div class="empty">Não foi possível carregar os dados. Verifique a URL e as permissões do Apps Script.</div>';
message(error.message);
}
}

function getDescription(item){
let description = item.categoria || item.Categoria || item.descricao || item.Descricao || '';
description = String(description);
return description.replace(/^\[(Fixa|Variável)\]\s*/i,'');
}

function getType(item){
return item.tipo || item.Tipo || 'Gasto';
}

function isPaid(item){
const value = item.pago ?? item.Pago;
return value === true || value === 'true' || value === 'Sim' || value === 'SIM' || value === 1 || value === '1';
}

function getAmount(item){
return Number(item.valor ?? item.Valor ?? 0);
}

function getMonth(item){
return item.mes || item.Mes || '';
}

function render(){
const income = entries.filter(e=>getType(e)==='Entrada').reduce((s,e)=>s+getAmount(e),0);
const expenses = entries.filter(e=>getType(e)!=='Entrada').reduce((s,e)=>s+getAmount(e),0);

$('income').textContent = money(income);
$('expenses').textContent = money(expenses);
$('balance').textContent = money(income-expenses);
$('balance').className = 'value '+(income-expenses>=0?'green':'red');

let filtered = entries.filter(e=>{
if(currentFilter==='paid') return isPaid(e);
if(currentFilter==='unpaid') return !isPaid(e);
if(currentFilter==='income') return getType(e)==='Entrada';
return true;
});

filtered.sort((a,b)=>String(getMonth(b)).localeCompare(String(getMonth(a))));

if(!filtered.length){
$('entries').innerHTML = '<div class="empty">Nenhuma movimentação encontrada.</div>';
return;
}

$('entries').innerHTML = filtered.map(item=>{
const id = item.id || item.ID;
const type = getType(item);
const paid = isPaid(item);
const description = getDescription(item);
const amount = getAmount(item);
const person = item.pessoa || item.Pessoa || '';
const month = getMonth(item);
const isIncome = type==='Entrada';

return `
<div class="entry">
<div>
<div class="entry-title">${escapeHTML(description)}</div>
<div class="entry-meta">${escapeHTML(person)} · ${escapeHTML(month)} · ${escapeHTML(type)}</div>
<span class="status ${paid?'paid':''}">${isIncome?(paid?'Recebido':'Não recebido'):(paid?'Pago':'Não pago')}</span>
</div>
<div class="entry-right">
<div class="entry-value ${isIncome?'green':'red'}">${money(amount)}</div>
<div class="actions">
<button class="small secondary" onclick="togglePaid('${escapeJS(id)}')">${paid?'Desmarcar':'Confirmar'}</button>
<button class="small secondary" onclick="editEntry('${escapeJS(id)}')">Editar</button>
<button class="small danger" onclick="deleteEntry('${escapeJS(id)}')">Excluir</button>
</div>
</div>
</div>`;
}).join('');
}

function escapeHTML(value){
return String(value ?? '').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

function escapeJS(value){
return String(value ?? '').replace(/\\/g,'\\\\').replace(/'/g,"\\'").replace(/\n/g,'');
}

function resetForm(){
$('entryForm').reset();
$('entryId').value='';
$('formTitle').textContent='Adicionar movimentação';
$('saveButton').textContent='Adicionar';
$('cancelEdit').style.display='none';
$('month').value=new Date().toISOString().slice(0,7);
updateType();
}

function editEntry(id){
const item = entries.find(e=>String(e.id || e.ID)===String(id));
if(!item) return;

$('entryId').value = id;
$('person').value = item.pessoa || item.Pessoa || 'Diego';
$('type').value = getType(item);

const rawCategory = String(item.categoria || item.Categoria || '');
const match = rawCategory.match(/^\[(Fixa|Variável)\]/i);
$('expenseType').value = match ? match[1] : 'Fixa';

$('month').value = getMonth(item);
$('description').value = getDescription(item);
$('amount').value = getAmount(item);

$('formTitle').textContent='Editar movimentação';
$('saveButton').textContent='Salvar alterações';
$('cancelEdit').style.display='block';
updateType();
window.scrollTo({top:0,behavior:'smooth'});
}

$('entryForm').addEventListener('submit',async e=>{
e.preventDefault();
if(!API_URL){message('Configure primeiro a URL do Apps Script.');return;}

const type = $('type').value;
const expenseType = $('expenseType').value;
const description = $('description').value.trim();
const category = type==='Entrada' ? description : `[${expenseType}] ${description}`;

const payload = {
action:'save',
id:$('entryId').value || undefined,
mes:$('month').value,
pessoa:$('person').value,
tipo:type,
categoria:category,
valor:Number($('amount').value),
pago:false
};

try{
$('saveButton').disabled=true;
$('saveButton').textContent='Salvando...';
const response = await fetch(API_URL,{
method:'POST',
headers:{'Content-Type':'text/plain;charset=utf-8'},
body:JSON.stringify(payload)
});
if(!response.ok) throw new Error('Erro ao salvar.');
const result = await response.json();
if(result.error) throw new Error(result.error);
message('Movimentação salva com sucesso!');
resetForm();
await loadData();
}catch(error){
message('Erro ao salvar: '+error.message);
}finally{
$('saveButton').disabled=false;
$('saveButton').textContent=$('entryId').value?'Salvar alterações':'Adicionar';
}
});

async function togglePaid(id){
await sendAction({action:'togglePaid',id});
}

async function deleteEntry(id){
if(!confirm('Deseja realmente excluir esta movimentação?')) return;
await sendAction({action:'delete',id});
}

async function sendAction(payload){
try{
const response = await fetch(API_URL,{
method:'POST',
headers:{'Content-Type':'text/plain;charset=utf-8'},
body:JSON.stringify(payload)
});
if(!response.ok) throw new Error('Erro na comunicação.');
const result = await response.json();
if(result.error) throw new Error(result.error);
await loadData();
}catch(error){
message('Erro: '+error.message);
}
}

$('month').value=new Date().toISOString().slice(0,7);
updateType();
loadData();
</script>
</body>
</html>